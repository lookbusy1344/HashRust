{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(jj --ignore-working-copy root 2>/dev/null || git rev-parse --show-toplevel)\"/scripts/agent-pre-push-hook.sh",
            "timeout": 600,
            "statusMessage": "Running pre-push checks"
          }
        ]
      }
    ]
  }
}
